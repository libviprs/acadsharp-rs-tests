# Rust / Cargo
/target/
**/*.rs.bk
Cargo.lock

# Build artifacts
*.o
*.a
*.so
*.dylib
*.dll
*.lib
*.exe
*.pdb

# .NET. The reference oracle under reference/ is a JIT console app built with
# the pinned SDK; its intermediate and output directories are per-architecture
# and must never be committed. packages.lock.json is NOT here: it is the pin.
[Bb]in/
[Oo]bj/
*.user

# Python tooling. tools/ carries the fixture fetch/verify script and its
# stdlib-unittest suite, and running either leaves bytecode behind.
__pycache__/
*.py[cod]

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*

# Temporary files
/tmp/
*.tmp
*.bak
*.log

# PR-body drafts written into the worktree rather than a shared scratchpad, so
# two concurrent agent lanes cannot clobber each other's. The worktree IS the
# repo, so without this they get swept in by a careless `git add -A`.
.pr-*.md
