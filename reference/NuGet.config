<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org and nothing else. A machine-level NuGet.config that added a private
  feed would otherwise let `dotnet restore` resolve ACadSharp from somewhere
  this repository has never seen, and the lock file would still look clean.
  `<clear />` is the whole point of this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
